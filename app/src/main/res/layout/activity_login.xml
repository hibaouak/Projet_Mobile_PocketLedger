<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EBDF"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <!-- En-tête bordeaux en dégradé -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_login_header"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="46dp"
            android:paddingEnd="28dp"
            android:paddingBottom="52dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="PocketLedger"
                android:textColor="#FFF8EE"
                android:textSize="40sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.04"
                android:text="Mon budget personnel"
                android:textColor="#F1DAD2"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Carte ivoire légèrement superposée à l'en-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-24dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_login_card"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Bienvenue"
                android:textColor="#441D2A"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Connectez-vous à votre espace personnel."
                android:textColor="#705E59"
                android:textSize="15sp" />

            <!-- Nom d'utilisateur -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:labelFor="@id/editUsername"
                android:text="Nom d’utilisateur"
                android:textColor="#482F34"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints="username"
                android:background="@drawable/bg_login_field"
                android:backgroundTint="@null"
                android:hint="Ex. hiba"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions"
                android:minHeight="54dp"
                android:nextFocusForward="@id/editPassword"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:singleLine="true"
                android:textColor="#38272B"
                android:textColorHint="#796963"
                android:textSize="16sp" />

            <!-- Mot de passe -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/editPassword"
                android:text="Mot de passe"
                android:textColor="#482F34"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints="password"
                android:background="@drawable/bg_login_field"
                android:backgroundTint="@null"
                android:fontFamily="sans-serif"
                android:hint="Votre mot de passe"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:minHeight="54dp"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:singleLine="true"
                android:textColor="#38272B"
                android:textColorHint="#796963"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/checkRememberMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#722C43"
                android:minHeight="48dp"
                android:text="Se souvenir de moi"
                android:textColor="#59464A"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_button"
                android:backgroundTint="@null"
                android:minHeight="54dp"
                android:text="Se connecter"
                android:textAllCaps="false"
                android:textColor="#FFF8F1"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>